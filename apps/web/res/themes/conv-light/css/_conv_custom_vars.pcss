:root {
    /* Couleur principale */
    --accent-color: #0d1641;
    --primary-color: #1a2768;

    /* Sidebar */
    --sidebar-color: #0d1641;

    /* Room list */
    --roomlist-background-color: #f5f7fc;
    --roomlist-text-color: #0d1641;
    --roomlist-text-secondary-color: #64748b;
    --roomlist-highlights-color: #e9eefc;
    --roomlist-separator-color: #dbe3f0;

    /* Timeline */
    --timeline-background-color: #ffffff;
    --timeline-text-color: #1e293b;
    --timeline-text-secondary-color: #64748b;
    --timeline-highlights-color: #f5f8ff;

    /* Alertes */
    --warning-color: #dc2626;

    /* Tchap */
    --private-color: #0d1641;
    --forum-color: #0d1641;
}
